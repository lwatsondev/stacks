[Unit]
Description=ZNC
Wants=oidentd.service
After=oidentd.service

[Container]
Image=ghcr.io/linuxserver/znc:latest
AutoUpdate=registry
ContainerName=znc
Entrypoint=/usr/local/bin/znc
Exec=-d /config --foreground
RunInit=true
EnvironmentFile=../.env
Volume=../data:/config
Volume=../config/certbot/live:/certbot/live:ro
Volume=../config/certbot/archive:/certbot/archive:ro
Network=host

[Service]
Restart=always

[Install]
WantedBy=default.target
