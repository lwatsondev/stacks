# The directory that config/ and data/ live under. Defaults to ./.
# For any other location, create the directory tree there manually.
# BASE_DIR=

# PUID=1000
# PGID=1000

# TZ=UTC

# POSTGRES_HOST=db-18
# POSTGRES_PORT=5432
# POSTGRES_DB=gitea
# POSTGRES_USER=gitea
# POSTGRES_PASSWORD=gitea
# GITEA__database__PASSWD=gitea

# REDIS_URL=redis://redis:6379

## Optional
# SHM_SIZE=128M
