[Unit]
Description=Gitea
Requires=postgres.service redis.service
After=postgres.service redis.service

[Container]
Image=docker.io/gitea/gitea:latest-rootless
ContainerName=gitea
EnvironmentFile=../.env
Environment=GITEA__database__DB_TYPE=postgres
Environment=GITEA__database__HOST=postgres:5432
Environment=GITEA__database__NAME=gitea
Environment=GITEA__database__USER=gitea
Environment=GITEA__queue__TYPE=redis
Environment=GITEA__queue__CONN_STR=redis://redis:6379
Environment=GITEA__cache__ADAPTER=redis
Environment=GITEA__cache__HOST=redis://redis:6379
Environment=GITEA__session__PROVIDER=redis
Environment=GITEA__session__PROVIDER_CONFIG=redis://redis:6379
Environment=GITEA__indexer__ISSUE_INDEXER_TYPE=db
Volume=../data/gitea:/var/lib/gitea
Volume=../config/gitea:/etc/gitea
Tmpfs=/tmp
Network=gitea.network
HealthCmd=curl -fSs http://localhost:3000/api/healthz
HealthInterval=10s
HealthTimeout=5s
HealthStartPeriod=10s

[Service]
Restart=always

[Install]
WantedBy=default.target
