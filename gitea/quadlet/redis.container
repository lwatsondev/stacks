[Unit]
Description=Valkey

[Container]
Image=docker.io/valkey/valkey:latest
AutoUpdate=registry
ContainerName=gitea-redis
RunInit=true
Exec=--dir /data --appendonly yes
Volume=../data/redis:/data
Network=gitea.network
NetworkAlias=redis
HealthCmd=valkey-cli ping | grep PONG
HealthInterval=10s
HealthTimeout=5s
HealthStartPeriod=10s
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=default.target
