[Unit]
Description=Paper
Requires=mariadb.service
After=mariadb.service

[Container]
Image=docker.io/itzg/minecraft-server:latest
AutoUpdate=registry
ContainerName=minecraft
ReadOnly=true
UserNS=keep-id
EnvironmentFile=../.env
Environment=EULA=TRUE
Volume=../config/minecraft:/config:ro
Volume=../data/minecraft:/data
Network=host
PodmanArgs=--interactive --tty
HealthCmd=mc-health
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=5m
StopTimeout=60

[Service]
Restart=always

[Install]
WantedBy=default.target
