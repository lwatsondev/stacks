[Unit]
Description=Deluge

[Container]
Image=ghcr.io/linuxserver/deluge:latest
ContainerName=deluge
EnvironmentFile=../.env
Volume=../config/deluge:/config
Volume=../data/torrents:/data/torrents
Tmpfs=/run:U,exec
PublishPort=6882:6882
PublishPort=6882:6882/udp
PublishPort=8112:8112

[Service]
Restart=always

[Install]
WantedBy=default.target
