[Unit]
Description=vaultwarden database

[Container]
Image=docker.io/library/postgres:18
ContainerName=vaultwarden_db_18
RunInit=true
EnvironmentFile=../.env
Environment=POSTGRES_DB=vaultwarden
Environment=POSTGRES_USER=vaultwarden
Exec=postgres -c config_file=/etc/postgresql/postgresql.conf
Volume=../data/db:/var/lib/postgresql
Volume=../config/db:/etc/postgresql
Network=vaultwarden.network
NetworkAlias=db-18
HealthCmd=pg_isready -q --dbname=vaultwarden --username=vaultwarden --host=127.0.0.1
HealthInterval=10s
HealthTimeout=5s
HealthStartPeriod=10s
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=default.target
