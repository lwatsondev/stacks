# The directory that config/ and data/ live under. Defaults to ./.
# For any other location, create the directory tree there manually.
# BASE_DIR=

# PUID=1000
# PGID=1000

# TZ=UTC

# ADMIN_TOKEN=

# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=vaultwarden
# POSTGRES_USER=vaultwarden
# POSTGRES_PASSWORD=vaultwarden
# DATABASE_URL=postgresql://vaultwarden:vaultwarden@postgres:5432/vaultwarden

## Optional
# SHM_SIZE=128M
