[Unit]
Description=Uptime Kuma

[Container]
Image=docker.io/louislam/uptime-kuma:2-slim-rootless
AutoUpdate=registry
ContainerName=uptime-kuma
EnvironmentFile=../.env
Volume=../data:/app/data
AddCapability=NET_RAW
HealthCmd=extra/healthcheck
HealthInterval=10s
HealthTimeout=30s
HealthStartPeriod=180s
HealthRetries=5

[Service]
Restart=always

[Install]
WantedBy=default.target
