# The directory that config/ and data/ live under. Defaults to ./.
# For any other location, create the directory tree there manually.
# BASE_DIR=

# PUID=1000
# PGID=1000

# TZ=UTC

# ALICE_PORT=8080

## The Frigate stack root, holding its config/frigate.db and data/{clips,exports}.
## Defaults to ./data/frigate, a mountpoint for e.g. sshfs from the Frigate host.
# ALICE_FRIGATE_DIR=/srv/stacks/frigate

## Optional: Docker resource limits
# ALICE_MEM_LIMIT=8G
# ALICE_CPU_LIMIT=8
