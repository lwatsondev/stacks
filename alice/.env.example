# The directory that config/ and data/ live under. Defaults to ./.
# For any other location, create the directory tree there manually.
# BASE_DIR=

## Compose only, the Makefile runs alice as the invoking user.
# PUID=1000
# PGID=1000

# TZ=UTC

# ALICE_PORT=8080

## The host address to publish ALICE_PORT on.
# ALICE_PUBLISH=127.0.0.1

## The Frigate stack root, holding its config/frigate.db and data/{clips,exports}.
## Defaults to ./data/frigate, a mountpoint for e.g. sshfs from the Frigate host.
# ALICE_FRIGATE_DIR=/srv/stacks/frigate

## The Makefile only: what `make up` mounts on ./data/frigate over sshfs.
# ALICE_FRIGATE_REMOTE=host:/path/to/frigate

## Optional: resource limits
# ALICE_MEM_LIMIT=8G
# ALICE_CPU_LIMIT=8
