# The directory that config/ and data/ live under. Defaults to ./.
# For any other location, create the directory tree there manually.
# BASE_DIR=

# PUID=1000
# PGID=1000

# TZ=UTC

# CAPPUCCINO_NICK=
# CAPPUCCINO_REALNAME=cappuccino
# CAPPUCCINO_USERNAME=cappuccino
# CAPPUCCINO_HOST=
# CAPPUCCINO_PORT=6697
# CAPPUCCINO_SSL=true

# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=cappuccino
# POSTGRES_USER=cappuccino
# POSTGRES_PASSWORD=cappuccino

## Optional
# SHM_SIZE=128M
# CAPPUCCINO_SENTRY__DSN=
# CAPPUCCINO_PLUGINS__LASTFM__API_KEY=
# CAPPUCCINO_PLUGINS__NICKSERV__PASSWORD=
