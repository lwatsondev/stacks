[Unit]
Description=caddy

[Container]
Image=ghcr.io/caddybuilds/caddy-cloudflare:latest
ContainerName=caddy
RunInit=true
ReadOnly=true
EnvironmentFile=../.env
Volume=../data:/data
Volume=../data/config:/config
Volume=../config:/etc/caddy
Network=host

[Service]
Restart=always

[Install]
WantedBy=default.target
